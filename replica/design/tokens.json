{
  "_about": "Default Petify brand roles for the admin UX. Runtime colors continue to come from siteAppearance.js and the CSS custom properties in 00-foundation.css.",
  "color": {
    "bg": "#f8fafc",
    "surface": "#ffffff",
    "border": "#dbe3ea",
    "border-input": "#64748b",
    "text": "#0f172a",
    "text-muted": "#475569",
    "primary": "#1d4ed8",
    "primary-dark": "#1e3a8a",
    "accent": "#f59e0b",
    "on-accent": "#0f172a",
    "danger": "#b91c1c",
    "success": "#1e3a8a"
  },
  "pairs": [
    ["text", "bg"],
    ["text", "surface"],
    ["text-muted", "bg"],
    ["text-muted", "surface"],
    ["primary", "surface"],
    ["primary-dark", "surface"],
