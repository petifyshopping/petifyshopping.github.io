  "space": [0, 4, 8, 12, 16, 24, 32, 48, 64],
  "radius": { "sm": 11, "md": 16, "lg": 22, "pill": 999 },
  "motion": {
    "fast": "150ms",
    "base": "200ms",
    "ease": "cubic-bezier(.2,.8,.2,1)"
  }
